# ──────────────────────────────────────────────
# Supabase — required
# Get these from: https://supabase.com/dashboard → Project Settings → API
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ──────────────────────────────────────────────
# Supabase Service Role (SERVER-SIDE ONLY) — REQUIRED for signup
#
# Used by the signUpAction Server Action to call supabase.auth.admin.createUser().
# The public signUp() endpoint rejects the synthetic .invalid email domain;
# the admin endpoint bypasses email format validation.
#
# Never expose this key to the browser or client components.
# Never prefix with NEXT_PUBLIC_.
# Get this from: Supabase dashboard → Project Settings → API → service_role key
# ──────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Phone auth HMAC secret (SERVER-SIDE ONLY)
#
# Used to derive a stable, privacy-preserving synthetic email identifier
# from each user's E.164 phone number.  NEVER prefix with NEXT_PUBLIC_;
# this must never appear in the browser bundle, error messages, logs, or
# API responses.
#
# Entropy requirement:
#   Must be at least 32 bytes of cryptographically random data.
#   The value stored here is the raw secret — not a hash of it.
#
# Generation (local and Vercel):
#   openssl rand -base64 32
#   Copy the full output (44 characters) and set it here or in the
#   Vercel dashboard under Settings → Environment Variables.
#
# Backup:
#   Store the secret in a password manager or a secrets vault (e.g.
#   1Password, Vault, AWS Secrets Manager).  Keep at least one offline
#   copy.  Loss of this secret means no existing user can sign in.
#
# Rotation procedure (ONLY when required):
#   WARNING: Changing this secret invalidates every existing user's
#   synthetic identifier.  All users will be locked out until their
#   account is migrated.  Never rotate without completing ALL steps:
#     1. Generate a new secret.
#     2. Write and test a migration script that, for each auth.users row,
#        computes the old synthetic email (old secret) and the new one
#        (new secret), then updates auth.users.email to the new value.
#     3. Run the migration script against a staging project with a copy
#        of production data.  Verify every user can still sign in.
#     4. Apply the migration script to production in a maintenance window.
#     5. Only then update PHONE_HMAC_SECRET in all environments.
#     6. Remove the old secret from all vaults after confirming success.
# ──────────────────────────────────────────────
PHONE_HMAC_SECRET=

# ──────────────────────────────────────────────
# Signup rate limiting — Upstash Redis (SERVER-SIDE ONLY)
#
# Provides persistent, distributed sliding-window rate limiting for the
# public signUpAction endpoint.  Required in production.  In development
# you may point at a free Upstash database or leave these unset — but if
# unset, signUpAction will FAIL CLOSED (returns a 503-style error) to
# prevent unlimited unauthenticated account creation.
#
# Setup:
#   1. Create a free account at https://upstash.com/
#   2. Create a Redis database (choose region closest to your deployment).
#   3. Copy "REST URL" and "REST Token" from the database details page.
#   4. Set the variables below (both here and in Vercel → Settings →
#      Environment Variables for each environment).
#
# Free tier: 10,000 commands/day, 256 MB.  No credit card required.
# Pricing:   $0.20 per 100k commands beyond the free tier.
#
# Tuning (optional):
#   SIGNUP_RATE_LIMIT_REQUESTS       — max attempts per IP per window (default 5)
#   SIGNUP_RATE_LIMIT_WINDOW_SECONDS — window size in seconds (default 3600 = 1h)
# ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional tuning — omit to use defaults (5 requests / 1 hour)
# SIGNUP_RATE_LIMIT_REQUESTS=5
# SIGNUP_RATE_LIMIT_WINDOW_SECONDS=3600

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
